// 家事ルーレットアプリのデータモデル定義。
// 本番・開発ともにNeon(PostgreSQL)を使用する。Neonのサーバーレス接続では
// アプリ実行用にコネクションプーリング経由(url)、マイグレーション実行用に
// 直接接続(directUrl)を使い分けるのがPrisma公式推奨構成のため、両方定義する。
// PostgreSQLはネイティブに外部キー制約をサポートするため relationMode の
// エミュレーションは不要。

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ユーザー（家事データ・履歴はすべてこのモデルに紐づいて分離される）
model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tasks        HouseworkTask[]
  histories    HistoryEntry[]
}

// 家事マスタ（ユーザーごとに保持する）
model HouseworkTask {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  durationMin Int
  difficulty  Int // 1(かなり楽)〜5(大変)
  category    String?
  description String?
  isActive    Boolean        @default(true) // 論理削除フラグ（履歴の整合性を保つため物理削除しない）
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  histories   HistoryEntry[]

  @@index([userId])
}

// 完了した家事の履歴（家事が削除されても記録が残るよう名前・所要時間をスナップショットする）
model HistoryEntry {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      String?
  task        HouseworkTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskName    String
  durationMin Int
  completedAt DateTime       @default(now())

  @@index([userId, completedAt])
  @@index([taskId])
}

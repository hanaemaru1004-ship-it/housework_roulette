# 開発環境ではSQLiteファイルを使用する。
# 本番移行時は prisma/schema.prisma の provider を "mysql" に変更し、
# ここをMySQLの接続文字列 (mysql://user:password@host:3306/dbname) に差し替える。
DATABASE_URL="file:./dev.db"

# NextAuth (Auth.js) のセッション署名用シークレット。
# `npx auth secret` または `openssl rand -base64 32` で生成した値を設定する。
AUTH_SECRET="replace-with-a-random-secret"

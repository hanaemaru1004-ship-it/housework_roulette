# Neon(PostgreSQL)の接続文字列。Neonダッシュボードの「Connect」から取得する。
# DATABASE_URL: アプリ実行用（コネクションプーリング経由、ホスト名に -pooler が付く方）
# DIRECT_URL:   マイグレーション実行用（プーリングなしの直接接続）
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# NextAuth (Auth.js) のセッション署名用シークレット。
# `npx auth secret` または `openssl rand -base64 32` で生成した値を設定する。
AUTH_SECRET="replace-with-a-random-secret"
